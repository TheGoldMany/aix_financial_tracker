# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=penzugyi_user
DB_PASSWORD=your_secure_password_here
DB_DATABASE=penzugyi_koveto

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_here_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_minimum_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Application Configuration
NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Email Configuration (for password reset, invoices, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@penzugyikoveto.hu

# File Storage (AWS S3 or compatible)
S3_ENDPOINT=
S3_BUCKET=penzugyi-koveto-files
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Payment Gateway (Stripe)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Monitoring
SENTRY_DSN=

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_PRO_FEATURES=true
